@page "/"

<div class="flash-beat-page home">
    <h1><FluentEmoji Value="@(new Emojis.Objects.Color.Default.MusicalNote())" /> FlashBeat</h1>

    <div class="quick-navigation">
        <FluentCard Width="350px" Height="200px" onclick="@(() => this.NavigateToInfiniteMode())">
            <h2><FluentEmoji Value="@(new Emojis.Objects.Color.Default.MusicalNotes())" /> Mode infini</h2>
            <p>Tente de trouver la musique aléatoire le plus vite posible !</p>
        </FluentCard>
    </div>
</div>