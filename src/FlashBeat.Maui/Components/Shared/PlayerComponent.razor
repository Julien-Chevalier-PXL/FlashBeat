@implements IAsyncDisposable

<flash-beat-player class="@this.GetCssClass()">
    <audio id="@($"flash-beat-player-audio-{this.elementId}")" type="audio/mpeg" onended="@this.OnAudioEndedAsync" />

    @if (this.isAudioPlaying)
    {
        <FluentButton aria-label="Pause"
                      Appearance="Appearance.Accent"
                      IconEnd="@this.PauseIcon"
                      Title="Pause"
                      Class="player-button"
                      OnClick="@(async (_) => await this.PlayOrPauseAsync().ConfigureAwait(true))"
                      Disabled="this.Disabled">
        </FluentButton>
    }
    else
    {
        <FluentButton aria-label="Play"
                      Appearance="Appearance.Accent"
                      IconEnd="@this.PlayIcon"
                      Title="Play"
                      Class="player-button"
                      OnClick="@(async (_) => await this.PlayOrPauseAsync().ConfigureAwait(true))"
                      Disabled="this.Disabled">
        </FluentButton>
    }

    @if (ShowStopButton)
    {
        <FluentButton aria-label="Stop"
                      Appearance="Appearance.Lightweight"
                      IconEnd="@(new Icons.Regular.Size24.Stop())"
                      Class="player-button"
                      OnClick="@(async (_) => await this.StopAsync().ConfigureAwait(true))"
                      Disabled="this.Disabled">
        </FluentButton>
    }
</flash-beat-player>