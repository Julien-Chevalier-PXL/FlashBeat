<flash-beat-deezer-player>
    <iframe id="deezer-widget"
            src="https://widget.deezer.com/widget/dark/track/@(this.TrackId)?&autoplay=false&radius=true"
            width="@this.Size"
            height="@this.Size"
            allowtransparency="true"
            allow="encrypted-media">
    </iframe>
</flash-beat-deezer-player>